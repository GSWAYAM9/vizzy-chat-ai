# Vizzy Chat AI - Hostinger Deployment Configuration
# Fill in your credentials and then run the deployment script

# ================================================
# DATABASE CONFIGURATION
# ================================================
# Get this from your Neon dashboard
# Format: postgresql://username:password@host:5432/database_name
DATABASE_URL=postgresql://YOUR_USERNAME:YOUR_PASSWORD@your-neon-host.neon.tech:5432/vizzy_db

# ================================================
# API KEYS - Get from respective services
# ================================================

# Groq API Key (for AI chat)
# Get from: https://console.groq.com
GROQ_API_KEY=gsk_YOUR_GROQ_KEY_HERE

# Stability AI Key (for image generation)
# Get from: https://platform.stability.ai/account/keys
STABILITY_AI_API_KEY=sk-YOUR_STABILITY_KEY_HERE

# ================================================
# DOMAIN CONFIGURATION
# ================================================
# Your domain name or server IP
YOUR_DOMAIN_HERE=your-domain.com
YOUR_SERVER_IP=YOUR_SERVER_IP_ADDRESS
YOUR_EMAIL=your-email@example.com

# ================================================
# QUICK START GUIDE
# ================================================
# 1. Fill in all the values above
# 2. Download deploy-hostinger.sh to your local computer
# 3. SSH into your Hostinger VPS:
#    ssh root@YOUR_SERVER_IP
# 4. Upload the script:
#    scp deploy-hostinger.sh root@YOUR_SERVER_IP:/root/
# 5. Make it executable and run:
#    chmod +x deploy-hostinger.sh
#    bash deploy-hostinger.sh
# 6. Follow the on-screen prompts

# ================================================
# AFTER DEPLOYMENT
# ================================================
# The script will create:
# - /home/vizzy-chat-ai/ (application directory)
# - Nginx reverse proxy on port 80/443
# - SSL certificate (HTTPS)
# - PM2 process manager (keeps app running 24/7)
# - Auto-renewal for SSL certificate
